/*
 * speed_t is the baud rate on macOS too, but tcsetattr() fails with
 * EINVAL for any rate without a B* constant; see baudrates.sh.
 */
#if !defined(__APPLE__) && B0 == 0@libserialport_baud_condition@
#define SPEED_T_IS_SANE 1
#else

#ifdef MAKE_BAUD_TABLE
static const struct std_baudrate MAKE_BAUD_TABLE [] = {
@libserialport_baud_table@};
#define NUM_STD_BAUDRATES ARRAY_SIZE(MAKE_BAUD_TABLE)
#endif /* MAKE_BAUD_TABLE */

#endif /* SPEED_T_IS_SANE */
